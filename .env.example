# Copy to a location OUTSIDE the repository (e.g. ~/.config/dsgen/env), fill in, chmod 600, then
#   source ~/.config/dsgen/env && python3 -m dsgen nordic_supply check --images openai
# Nothing here is read by the generator except through the environment; no file in the repo may hold a key.

# Image generation (only with --images ...). Pick one provider; both optional.
export OPENAI_API_KEY=
export GOOGLE_API_KEY=
# Google image default: gemini-2.5-flash-image (free tier with an AI Studio key; Google may train on free-tier data).
# Paid alternative: imagen-4.0-generate-001 (no free tier).
# export DSGEN_GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image
# OpenAI image defaults (optional): model gpt-image-1.5 | gpt-image-2 | gpt-image-1-mini; quality low | medium | high
# export DSGEN_OPENAI_IMAGE_MODEL=gpt-image-1.5
# export DSGEN_OPENAI_IMAGE_QUALITY=medium
# export DSGEN_OPENAI_IMAGE_SIZE=1024x1024

# H2 smoke test / database file: found automatically in ~/.m2; set only if elsewhere.
# export H2_JAR=/path/to/h2-2.4.240.jar
# PostgreSQL smoke test (--pg) uses Docker; image override:
# export DSGEN_PG_IMAGE=postgres:16-alpine
